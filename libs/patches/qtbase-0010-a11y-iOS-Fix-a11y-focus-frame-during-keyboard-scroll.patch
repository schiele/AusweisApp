From 096523c494a02579661211733ee891942db59944 Mon Sep 17 00:00:00 2001
From: Andreas Belke <andreas.belke@governikus.de>
Date: Thu, 16 Apr 2026 13:20:05 +0200
Subject: a11y iOS: Fix a11y focus frame during keyboard scroll
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

When the software keyboard appears, QIOSInputContext::scroll()
applies a CATransform3D sublayer transform to the root view
controller's view, visually translating all content upward.
This transform is purely visual and is not reflected in Qt's
coordinate system.

As a result, accessibilityFrame returns the untransformed Qt
coordinates from QAccessibleInterface::rect(), causing VoiceOver
to draw the focus rectangle at the original pre-scroll position
— typically overlapping the keyboard.

Fix this by reading the root view's sublayerTransform.m42 (the
Y translation component) and adjusting the returned CGRect
accordingly. When the keyboard is hidden, the transform is
identity and no adjustment is applied.

Task-number: QTBUG-145565
Pick-to: 6.11
Change-Id: If1e9472d93a0c3931b203076b0f9a13e440d838a
Reviewed-by: Assam Boudjelthia <assam.boudjelthia@qt.io>
(cherry picked from commit ce79582e19b25631d6346f8acd6d6c4960c7bfae)
---
 .../platforms/ios/quiaccessibilityelement.mm      | 15 ++++++++++++++-
 1 file changed, 14 insertions(+), 1 deletion(-)

diff --git x/qtbase/src/plugins/platforms/ios/quiaccessibilityelement.mm y/qtbase/src/plugins/platforms/ios/quiaccessibilityelement.mm
index bf4351d2ecec9233312648d2cb776a776bc31739..6c3ce3b1635cd7b39a3d5b0f03ba149741aa5af2 100644
--- x/qtbase/src/plugins/platforms/ios/quiaccessibilityelement.mm
+++ y/qtbase/src/plugins/platforms/ios/quiaccessibilityelement.mm
@@ -142,7 +142,20 @@ QT_NAMESPACE_ALIAS_OBJC_CLASS(QMacAccessibilityElement);
     }
 
     QRect rect = iface->rect();
-    return CGRectMake(rect.x(), rect.y(), rect.width(), rect.height());
+    CGRect frame = QRectF(rect).toCGRect();
+
+    // Adjust the frame to ensure focus rectangle aligns with the visually shifted
+    // content when onscreen keyboard is shown.
+    UIView *view = self.accessibilityContainer;
+    if ([view isKindOfClass:[UIView class]]) {
+        if (UIView *rootView = view.window.rootViewController.view) {
+            CATransform3D transform = rootView.layer.sublayerTransform;
+            if (!CATransform3DIsIdentity(transform))
+                frame.origin.y += transform.m42;
+        }
+    }
+
+    return frame;
 }
 
 - (UIAccessibilityTraits)accessibilityTraits
