From 02e6e3e281e13a460869ef76506c4d4f7419c4eb Mon Sep 17 00:00:00 2001
From: Jens Trillmann <jens.trillmann@governikus.de>
Date: Fri, 10 Jul 2026 11:29:54 +0200
Subject: A11y: Handle expanded property

Task-number: QTBUG-146552
Pick-to: 6.12
Change-Id: Ie507eadd06263378d3c05d9b1e18c5064e04c287
---
 src/quick/accessible/qaccessiblequickitem.cpp | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git x/qtdeclarative/src/quick/accessible/qaccessiblequickitem.cpp y/qtdeclarative/src/quick/accessible/qaccessiblequickitem.cpp
index 29a8cc8b1ae5521551fde7a9f79ec730b180ac1a..ebf64a726c439168747175393c03bc6618d814ae 100644
--- x/qtdeclarative/src/quick/accessible/qaccessiblequickitem.cpp
+++ y/qtdeclarative/src/quick/accessible/qaccessiblequickitem.cpp
@@ -413,6 +413,10 @@ QAccessible::State QAccessibleQuickItem::state() const
          || role() == QAccessible::Switch)
         && object()->property("checked").toBool())
         state.checked = true;
+    if (object()->property("expandable").toBool()) {
+        state.expandable = true;
+        state.expanded = object()->property("expanded").toBool();
+    }
     if (item()->activeFocusOnTab() || isTextRole(role()))
         state.focusable = true;
     if (item()->hasActiveFocus())
@@ -504,6 +508,10 @@ QStringList QAccessibleQuickItem::actionNames() const
     }
     if (state().focusable)
         actions.append(QAccessibleActionInterface::setFocusAction());
+    if (state().expandable) {
+        actions.append(QAccessibleActionInterface::toggleAction());
+        actions.append(QAccessibleActionInterface::pressAction());
+    }
 
     // ### The following can lead to duplicate action names.
     if (QQuickAccessibleAttached *attached = QQuickAccessibleAttached::attachedProperties(item()))
@@ -586,6 +594,16 @@ void QAccessibleQuickItem::doAction(const QString &actionName)
         }
         break;
     }
+    case QAccessible::Button: {
+        QVariant expanded = object()->property("expanded");
+        if (expanded.isValid()) {
+            if (actionName == QAccessibleActionInterface::toggleAction() ||
+                    actionName == QAccessibleActionInterface::pressAction()) {
+                object()->setProperty("expanded", QVariant(!expanded.toBool()));
+            }
+        }
+        break;
+    }
     default:
         break;
     }
